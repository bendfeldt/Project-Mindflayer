{
  "permissions": {
    "allow": [
      "Bash(databricks * list *--profile *)", "Bash(databricks * get *--profile *)",
      "Bash(databricks bundle validate *--profile *)", "Bash(databricks bundle summary *--profile *)",
      "Bash(python -m pytest*)", "Bash(ruff check*)", "Bash(ruff format --check*)"
