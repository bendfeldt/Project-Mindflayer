      "Bash(databricks auth login*)", "Bash(databricks auth logout*)", "Bash(databricks configure*)",
      "Bash(databricks bundle deploy*)", "Bash(databricks bundle run*)", "Bash(databricks bundle destroy*)",
      "Bash(databricks * create*)", "Bash(databricks * update*)", "Bash(databricks * delete*)",
      "Bash(databricks * start*)", "Bash(databricks * stop*)", "Bash(databricks * run-now*)"
    ]
  }
}
