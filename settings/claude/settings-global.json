{
  "permissions": {
    "allow": [
      "Bash(git diff*)", "Bash(git status*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git remote*)", "Bash(git rev-parse*)", "Bash(ls *)", "Bash(pwd)",
      "Bash(wc *)", "Bash(ruff check*)", "Bash(ruff format --check*)", "Bash(pytest*)"
    ],
    "deny": [
      "Read(.env*)", "Read(**/.env*)", "Read(**/*.tfvars)", "Read(**/secret*)",
      "Read(**/credential*)", "Read(**/token*)", "Read(**/*.pem)", "Read(**/*.key)",
      "Read(**/*.pfx)", "Read(**/*.p12)", "Read(**/.netrc)", "Read(**/.pgpass)",
      "Bash(printenv*)", "Bash(env)", "Bash(set)", "Bash(git push*)"
    ]
  }
}
